<UserControl x:Class="FrameHub.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:FrameHub.App.ViewModels.Library"
             xmlns:opt="clr-namespace:FrameHub.App.ViewModels.GameOptimization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel>
            <!-- The list is primary. Scanning and manual management stay compact. -->
            <StackPanel Visibility="{Binding ShowLibraryHome, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReadyCountText}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ScanMenuText}" Command="{Binding ScanAllCommand}" AutomationProperties.Name="{Binding ScanAllText}" Padding="14,8,10,8" />
                            <Button x:Name="ScanMenuButton" Style="{StaticResource PrimaryButton}" Content="▾" Click="ScanMenuButton_Click" AutomationProperties.Name="{Binding ScanMenuText}" Margin="2,0,0,0" Padding="10,8">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding ScanAllText}" Command="{Binding ScanAllCommand}" />
                                        <MenuItem Header="{Binding ScanSteamText}" Command="{Binding ScanSteamCommand}" />
                                        <MenuItem Header="{Binding ScanEpicText}" Command="{Binding ScanEpicCommand}" />
                                        <MenuItem Header="{Binding ScanRiotText}" Command="{Binding ScanRiotCommand}" />
                                        <MenuItem Header="{Binding ScanCustomText}" Command="{Binding ScanCustomCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding RefreshStatusText}" Command="{Binding RefreshStatusCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding AddManuallyText}" Command="{Binding ToggleManageLibraryCommand}" />
                    </WrapPanel>
                </Grid>

                <Expander Header="{Binding ManageLibraryTitle}" Margin="0,0,0,16" IsExpanded="{Binding ShowManageLibrary, Mode=TwoWay}">
                    <Border Style="{StaticResource SectionSurface}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SourcesNoteText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ManualTitle}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding SafetyNoteDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding DisplayNameLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" /><TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding ExecutableLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding NewExecutablePath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding BrowseText}" Command="{Binding BrowseExecutableCommand}" Margin="8,0,0,0" /></Grid></StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding NewItemType}" Width="180" HorizontalAlignment="Left" /><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding AddManualText}" Command="{Binding AddManualCommand}" /></Grid>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{StaticResource BrushBorderSubtle}" Margin="24,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding CustomFoldersTitle}" Style="{StaticResource SectionTitleText}" />
                                <ItemsControl ItemsSource="{Binding CustomFolders}" Margin="0,12,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" ToolTip="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding AddFolderText}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Style="{StaticResource DataPanel}" Padding="0">
                    <StackPanel>
                        <Grid Margin="20,16,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ItemsTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Grid.Column="1" Text="{Binding ReadyBadgeText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" /></Grid>
                        <Grid Margin="20,0,16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource HintTextBox}" Tag="{Binding SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding SearchPlaceholder}" />
                            <TextBlock Grid.Column="1" Text="{Binding FilterLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding FilterLabels}" SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" MinWidth="160" AutomationProperties.Name="{Binding FilterLabel}" />
                        </Grid>
                        <ListBox x:Name="LibraryItems" ItemsSource="{Binding FilteredItems}" Margin="12,0,12,12" MaxHeight="420" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type lib:LibraryItemViewModel}">
                                    <Border x:Name="GameRow" Style="{StaticResource InlineRow}" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BrushSurfaceInteractive}" Margin="0,0,12,0"><Grid><Image Source="/FrameHub.App;component/Assets/FrameHubLogo.png" Width="26" Height="26" Opacity="0.2" RenderOptions.BitmapScalingMode="HighQuality" /><Image Source="{Binding IconSource}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" /></Grid></Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding SourceText}" Style="{StaticResource CaptionText}" /><TextBlock Text="  ·  " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TypeText}" Style="{StaticResource CaptionText}" /></StackPanel></StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                                <TextBlock Text="{Binding StatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExecutableMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ProfileText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ExeMissingText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushWarning}" Margin="0,2,0,0" Visibility="{Binding IsExecutableMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Content="{Binding DataContext.DetailsOptimizeText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                            <Button Grid.Column="4" AutomationProperties.Name="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" ToolTip="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Opacity="0.35"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=GameRow}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1" /></Trigger></Style.Triggers></Style></Button.Style><Path Data="{StaticResource IconTrash}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" /></Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Margin="20,8,20,24"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorder}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasFilteredItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                            <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasItems, ElementName=LibraryItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ItemsTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ScanAllText}" Command="{Binding ScanAllCommand}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding AddFolderText}" Command="{Binding AddFolderCommand}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource SubtleButton}" Content="{Binding AddManuallyText}" Command="{Binding OpenManageLibraryCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center" Visibility="{Binding HasItems, ElementName=LibraryItems, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding ItemsTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyFilteredText}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Game detail view. -->
            <StackPanel Visibility="{Binding ShowSelectedDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Style="{StaticResource GhostButton}" Content="{Binding BackToLibraryText}" Command="{Binding BackToLibraryCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />

                <Border Style="{StaticResource HeroCardBorder}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="8" Background="{StaticResource BrushSurfaceInteractive}" Margin="0,0,16,0"><Grid><Image Source="/FrameHub.App;component/Assets/FrameHubLogo.png" Width="38" Height="38" Opacity="0.2" /><Image Source="{Binding SelectedItem.IconSource}" Width="42" Height="42" RenderOptions.BitmapScalingMode="HighQuality" /></Grid></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedItemTitle}" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="{Binding SelectedItem.ExecutablePath}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding SelectedItem.IsBackgroundApp, Converter={StaticResource BoolToVisibilityConverter}}">
                                <CheckBox Content="{Binding RemoteControlOptInText}" IsChecked="{Binding SelectedItem.AllowRemoteControl, Mode=TwoWay}" />
                                <TextBlock Text="{Binding RemoteControlOptInHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="22,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                            <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="360">
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding LaunchText}" Command="{Binding LaunchSelectedCommand}" ToolTip="{Binding LaunchText}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding BenchmarkText}" Command="{Binding BenchmarkSelectedCommand}" ToolTip="{Binding BenchmarkButtonTooltip}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding ApplyProfileText}" Command="{Binding ApplyLinkedProfileCommand}" ToolTip="{Binding ApplyProfileButtonTooltip}" Margin="0,0,8,8" />
                                <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenSelectedFolderCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                    </Grid>
                </Border>

                <TabControl Style="{StaticResource FrameHubTabControl}" ItemContainerStyle="{StaticResource FrameHubTabItem}">
                    <TabItem Header="{Binding CpuTabTitle}">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProfileEditorTitle}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding ProfileEditorHintText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,12" />

                                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CurrentOptimizationProfileTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CurrentOptimizationProfileText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding AvailableOptimizationModes}" SelectedItem="{Binding SelectedOptimizationModeOption}" DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding SelectedPriority}" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding SelectAllText}" Command="{Binding SelectAllCoresCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding ClearAllText}" Command="{Binding ClearAllCoresCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding DisableSmtText}" Command="{Binding DisableSmtCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="{Binding DisableECoresText}" Command="{Binding DisableECoresCommand}" Margin="0,0,8,8" />
                                    </WrapPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CpuCoresTitle}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding PhysicalCores}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource InlineRow}" Padding="4,8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" />
                                                                    <ProgressBar Grid.Row="1" Maximum="100" Value="{Binding LoadUsage}" Height="4" Margin="0,6,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding CpuThreadsTitle}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,8" />
                                                <ItemsControl ItemsSource="{Binding ThreadCores}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource InlineRow}" Padding="4,8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" />
                                                                    <ProgressBar Grid.Row="1" Maximum="100" Value="{Binding LoadUsage}" Height="4" Margin="0,6,0,0" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding CreateUpdateProfileText}" Command="{Binding CreateUpdateProfileCommand}" HorizontalAlignment="Stretch" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SectionSurface}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CpuInfoTitle}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding DetectedProcessorLabel}" Style="{StaticResource TinyCapsText}" Margin="0,16,0,4" />
                                    <TextBlock Text="{Binding DetectedProcessorText}" FontWeight="SemiBold" TextWrapping="Wrap" />

                                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecommendedPresetTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RecommendedPresetText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding TestWarningText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Foreground="{StaticResource BrushWarning}" Margin="0,12,0,0" />
                                    <Expander Header="{Binding CpuModeExplanationTitle}" Margin="0,16,0,0">
                                        <StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding CpuSetsExplanation}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" /><TextBlock Text="{Binding AffinityExplanation}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,7,0,0" /><TextBlock Text="{Binding CpuTipsTitle}" Style="{StaticResource TinyCapsText}" Margin="0,13,0,7" /><TextBlock Text="{Binding CoreZeroTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding CoreZeroExplanation}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,8" /><TextBlock Text="{Binding SmtTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding SmtExplanation}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,8" /><TextBlock Text="{Binding IntelECoreTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding IntelECoreExplanation}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding GraphicsTabTitle}" Visibility="{Binding IsCs2Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Style="{StaticResource SectionSurface}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Cs2OptimizerTitle}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding Cs2OptimizerSubtitle}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,16" />

                                <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Cs2OverviewTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                                        <UniformGrid Columns="2" Rows="2">
                                            <Border Background="{StaticResource BrushSurfaceInteractive}" CornerRadius="8" Padding="12" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="{Binding Cs2ResolutionTitle}" Style="{StaticResource TinyCapsText}" /><TextBlock Text="{Binding Cs2ResolutionDisplay}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushSurfaceInteractive}" CornerRadius="8" Padding="12" Margin="8,0,0,8">
                                                <StackPanel><TextBlock Text="{Binding Cs2DisplayModeTitle}" Style="{StaticResource TinyCapsText}" /><TextBlock Text="{Binding Cs2DisplayModeDisplay}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushSurfaceInteractive}" CornerRadius="8" Padding="12" Margin="0,8,8,0">
                                                <StackPanel><TextBlock Text="{Binding Cs2VsyncTitle}" Style="{StaticResource TinyCapsText}" /><TextBlock Text="{Binding Cs2VsyncDisplay}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushSuccessSoft}" CornerRadius="8" Padding="12" Margin="8,8,0,0">
                                                <StackPanel><TextBlock Text="{Binding Cs2BaselineTitle}" Style="{StaticResource TinyCapsText}" /><TextBlock Text="{Binding Cs2BaselineMatchDisplay}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource BrushSuccess}" /></StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding Cs2ConfigPathLabel}" Style="{StaticResource TinyCapsText}" Margin="0,12,0,4" />
                                        <TextBlock Text="{Binding Cs2ConfigPath}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" />
                                </StackPanel>

                                <WrapPanel Margin="0,0,0,12">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding ScanCs2Text}" Command="{Binding ScanCs2Command}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding BackupCs2Text}" Command="{Binding BackupCs2Command}" IsEnabled="{Binding CanEditCs2Config}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyCs2Text}" Command="{Binding ApplyCs2PresetCommand}" IsEnabled="{Binding CanEditCs2Config}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding RestoreCs2Text}" Command="{Binding RestoreCs2BackupCommand}" IsEnabled="{Binding CanEditCs2Config}" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Cs2StatusMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Cs2EditLockMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource BrushWarning}" />

                                <StackPanel Visibility="{Binding NeedsCs2AccountSelection, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Cs2AccountLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Cs2Accounts}" SelectedItem="{Binding SelectedCs2Account}" DisplayMemberPath="UserdataId" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Cs2AccountSelectionMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Cs2PresetText}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding Cs2Presets}" SelectedItem="{Binding SelectedCs2Preset}" DisplayMemberPath="DisplayName" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Cs2PresetDescription}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                                </Grid>

                                <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="16" IsEnabled="{Binding CanEditCs2Config}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Cs2SettingsListTitle}" Style="{StaticResource SectionTitleText}" />
                                                <TextBlock Text="{Binding Cs2SettingsListHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Cs2BaselineMatchDisplay}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Top" Margin="12,3,0,0" />
                                        </Grid>

                                        <Border Background="{StaticResource BrushSurfaceInteractive}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="{Binding Cs2TableSettingHeader}" Style="{StaticResource TinyCapsText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Cs2TableCurrentHeader}" Style="{StaticResource TinyCapsText}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Cs2TableRecommendedHeader}" Style="{StaticResource TinyCapsText}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Cs2TableSetHeader}" Style="{StaticResource TinyCapsText}" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Cs2SettingChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type opt:Cs2SettingChangeViewModel}">
                                                    <Border Background="{StaticResource BrushSurfaceRaised}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanApply}" ToolTip="{Binding ApplyHint}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="{StaticResource BrushBackgroundAlt}" CornerRadius="6" Padding="9,7" Margin="0,0,8,0" MinHeight="48"><TextBlock Text="{Binding CurrentDisplayValue}" TextWrapping="Wrap" VerticalAlignment="Top" /></Border>
                                                            <Border Grid.Column="3" Background="{StaticResource BrushSuccessSoft}" CornerRadius="6" Padding="9,7" Margin="0,0,8,0" MinHeight="48"><TextBlock Text="{Binding RecommendedDisplayValue}" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="{StaticResource BrushSuccess}" /></Border>
                                                            <ComboBox Grid.Column="4" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" IsEnabled="{Binding CanApply}" DisplayMemberPath="DisplayName" MinHeight="36" Padding="10,7" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="{Binding ConfigTabTitle}" Visibility="{Binding IsCs2Selected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="Transparent" Padding="0" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ConfigTabTitle}" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="{Binding Cs2AutoexecSubtitle}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <TextBlock Text="{Binding Cs2SteamCloudWarningText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushWarning}" />
                                        <TextBlock Text="{Binding Cs2EditLockMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource BrushWarning}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{Binding Cs2AutoexecOpenFolderText}" Command="{Binding OpenCs2AutoexecFolderCommand}" />
                                </Grid>

                                <Border Style="{StaticResource SoftCardBorder}" IsEnabled="{Binding CanEditCs2Config}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Cs2AutoexecTitle}" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Text="{Binding Cs2AutoexecSubtitle}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                        <TextBlock Text="{Binding Cs2AutoexecPathLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Cs2AutoexecPath}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <WrapPanel Margin="0,0,0,16">
                                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding Cs2AutoexecOpenCreateText}" Command="{Binding LoadCs2AutoexecCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource DangerSubtleButton}" Content="{Binding AutoexecClearText}" Command="{Binding ClearCs2AutoexecCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding Cs2AutoexecSaveText}" Command="{Binding SaveCs2AutoexecCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding AutoexecPreviewTitle}" Style="{StaticResource DataTitleText}" Margin="0,0,0,8" />
                                        <TextBox Style="{StaticResource CodeEditorTextBox}" Text="{Binding Cs2AutoexecText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="340" />
                                        <TextBlock Text="{Binding Cs2AutoexecStatusMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,14" />

                                        <UniformGrid Columns="3" Margin="0,0,0,16">
                                            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="12" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AutoexecGeneralSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                    <TextBlock Text="{Binding Cs2AutoexecFpsLabel}" Style="{StaticResource TinyCapsText}" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding FpsMaxPlaceholder}" Text="{Binding SelectedCs2FpsMax, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding AddText}" Command="{Binding InsertCs2FpsMaxCommand}" Margin="8,0,0,0" /></Grid>
                                                    <TextBlock Text="{Binding MouseSensitivityText}" Style="{StaticResource TinyCapsText}" /><Grid Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding MouseSensitivityPlaceholder}" Text="{Binding Cs2MouseSensitivity, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding AddText}" Command="{Binding InsertCs2SensitivityCommand}" Margin="8,0,0,0" /></Grid>
                                                    <TextBlock Text="{Binding VolumeText}" Style="{StaticResource TinyCapsText}" /><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding VolumePlaceholder}" Text="{Binding Cs2Volume, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding AddText}" Command="{Binding InsertCs2VolumeCommand}" Margin="8,0,0,0" /></Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="12" Margin="4,0,4,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AutoexecQolSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding Cs2AutoexecRadarText}" Command="{Binding InsertCs2RadarCommand}" Margin="0,0,0,8" />
                                                    <Button Style="{StaticResource SecondaryButton}" Content="{Binding AutoexecConsoleText}" Command="{Binding InsertCs2ConsoleCommand}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource BrushSurface}" CornerRadius="8" Padding="12" Margin="8,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AutoexecBindsSectionTitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding SmokeKeyPlaceholder}" Text="{Binding Cs2SmokeKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SmokeKeyTooltip}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding SmokeBindText}" Command="{Binding InsertCs2SmokeBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding FlashKeyPlaceholder}" Text="{Binding Cs2FlashKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding FlashKeyTooltip}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding FlashBindText}" Command="{Binding InsertCs2FlashBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding MolotovKeyPlaceholder}" Text="{Binding Cs2MolotovKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding MolotovKeyTooltip}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding MolotovBindText}" Command="{Binding InsertCs2MolotovBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding HeKeyPlaceholder}" Text="{Binding Cs2HeKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding HeKeyTooltip}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding HeBindText}" Command="{Binding InsertCs2HeBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource HintTextBox}" Tag="{Binding VoiceKeyPlaceholder}" Text="{Binding Cs2VoiceKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding VoiceKeyTooltip}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding VoiceBindText}" Command="{Binding InsertCs2VoiceBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Cs2JumpBindModes}" SelectedItem="{Binding SelectedCs2JumpBindMode}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding JumpBindText}" Command="{Binding InsertCs2JumpBindCommand}" Margin="8,0,0,0" /></Grid>
                                                    <TextBlock Text="{Binding AutoexecCustomBindTitle}" Style="{StaticResource TinyCapsText}" Margin="0,6,0,6" />
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Cs2CustomBindKey, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding KeyText}" /><TextBox Grid.Column="1" Text="{Binding Cs2CustomBindCommandText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding CommandText}" Margin="8,0,0,0" /><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding AddText}" Command="{Binding InsertCs2CustomBindCommand}" Margin="8,0,0,0" /></Grid>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
