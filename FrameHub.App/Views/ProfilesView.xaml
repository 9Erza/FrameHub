<UserControl x:Class="FrameHub.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FrameHub.App.Helpers">
    <UserControl.Resources><helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" /></UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DataPanel}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="16,14,14,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SavedProfilesTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding ProfilesCountText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding RefreshText}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" AutomationProperties.Name="{Binding RefreshText}" /></Grid>
                <Grid Grid.Row="1" Margin="16,0,14,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding SearchPlaceholderText}" ToolTip="{Binding SearchPlaceholderText}" />
                    <TextBlock Grid.Column="0" Text="{Binding SearchPlaceholderText}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="2" Margin="16,0,14,10" Padding="10" CornerRadius="8" Background="{StaticResource BrushWarningSoft}" Visibility="{Binding HasConflictWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ConflictWarningText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>

                <DataGrid x:Name="ProfilesGrid" Grid.Row="3" Margin="1" ItemsSource="{Binding ProfilesView}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserSortColumns="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{Binding SavedProfilesTitle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{Binding Data.NameHeader, Source={StaticResource VmProxy}}" Width="*" MinWidth="180" SortMemberPath="ProcessName"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProcessName}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding Data.ModeHeader, Source={StaticResource VmProxy}}" Binding="{Binding DisplayOptimizationMode}" Width="150" />
                        <DataGridTextColumn Header="{Binding Data.PriorityHeader, Source={StaticResource VmProxy}}" Binding="{Binding DisplayPriority}" Width="105" />
                        <DataGridTemplateColumn Header="{Binding Data.EnabledHeader, Source={StaticResource VmProxy}}" Width="76" SortMemberPath="IsEnabled"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="ProfileEnabledCheckBox_Changed" Unchecked="ProfileEnabledCheckBox_Changed" AutomationProperties.Name="{Binding ProcessName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Margin="16" Panel.ZIndex="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorder}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ProfilesGrid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="{Binding SavedProfilesTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FirstProfileHintText}" Style="{StaticResource CaptionText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding CreateFirstProfileText}" Command="{Binding CreateFirstProfileCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" AutomationProperties.Name="{Binding CreateFirstProfileText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SectionSurface}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="420">
                    <Border Padding="24" Background="Transparent">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsProfileSelected}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                            <TextBlock Text="{Binding SelectProfileTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SelectProfileDescription}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsProfileSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ProfileDetailsTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ProfileDetailsHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <Border Padding="10" CornerRadius="8" Background="{StaticResource BrushWarningSoft}" Margin="0,0,0,12" Visibility="{Binding IsEditorNoticeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding EditorNoticeText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="{Binding SelectedProfileDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" /></Border>

                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource DataTitleText}" />
                    <TextBlock Text="{Binding EditorHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,10" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ModeLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding AvailableOptimizationModes}" SelectedItem="{Binding SelectedOptimizationModeOption}" DisplayMemberPath="DisplayName" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding AvailablePriorities}" SelectedItem="{Binding SelectedPriority}" /></StackPanel></Grid>
                    <CheckBox Content="{Binding IsEnabledLabel}" IsChecked="{Binding IsProfileEnabled}" Margin="0,12,0,0" />

                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,16" />
                    <TextBlock Text="{Binding CoreSelectionTitle}" Style="{StaticResource DataTitleText}" Margin="0,0,0,9" />
                    <WrapPanel Margin="0,0,0,8"><Button Style="{StaticResource ToolbarButton}" Content="{Binding SelectAllText}" Command="{Binding SelectAllCommand}" Margin="0,0,6,6" /><Button Style="{StaticResource ToolbarButton}" Content="{Binding ClearAllText}" Command="{Binding ClearAllCommand}" Margin="0,0,6,6" /><Button Style="{StaticResource ToolbarButton}" Content="{Binding DisableSmtText}" Command="{Binding DisableSmtCommand}" Margin="0,0,6,6" /><Button Style="{StaticResource ToolbarButton}" Content="{Binding DisableECoresText}" Command="{Binding DisableECoresCommand}" Margin="0,0,6,6" /></WrapPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PhysicalCoresTitle}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,5" /><ItemsControl ItemsSource="{Binding PhysicalCores}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InlineRow}" Padding="0,7"><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding ThreadsTitle}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,0,0,5" /><ItemsControl ItemsSource="{Binding ThreadCores}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InlineRow}" Padding="0,7"><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid>

                    <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Ellipse Width="7" Height="7" Fill="{StaticResource BrushSuccess}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding WatcherInfoText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" /></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource PrimaryButton}" Content="{Binding SaveChangesButtonText}" Command="{Binding SaveProfileChangesCommand}" IsEnabled="{Binding IsEditorValid}" Margin="0,0,5,0" AutomationProperties.Name="{Binding SaveChangesButtonText}" /><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding ApplyButtonText}" Command="{Binding ApplyProfileCommand}" IsEnabled="{Binding IsEditorValid}" Margin="5,0,0,0" AutomationProperties.Name="{Binding ApplyButtonText}" /></Grid>
                    <Button Style="{StaticResource DangerButton}" Content="{Binding DeleteButtonText}" Command="{Binding DeleteProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
