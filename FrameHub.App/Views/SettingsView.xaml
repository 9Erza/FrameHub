<UserControl x:Class="FrameHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="False">
    <!-- The page title and description are owned by MainWindow/ShellViewModel. -->
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="ContentLayout" MaxWidth="1120" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="LeftSettingsColumn" Grid.Column="0" Grid.Row="0">
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding LanguageTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding LanguageDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding EnglishLabel}" IsChecked="{Binding IsEnglish, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,8,0" />
                            <RadioButton Content="{Binding PolishLabel}" IsChecked="{Binding IsPolish, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding StartupTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StartWithWindowsLabel}" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <StackPanel IsEnabled="{Binding StartupControlsEnabled}" Margin="0,0,0,12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartWithWindows}" Value="False"><Setter Property="Opacity" Value="0.48" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding StartupBehaviorLabel}" Style="{StaticResource SettingTitleText}" />
                            <TextBlock Text="{Binding StartupModeDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{Binding StartupNormalLabel}" IsChecked="{Binding StartupModeNormal, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0" />
                                <RadioButton Content="{Binding StartupMinimizedLabel}" IsChecked="{Binding StartupModeMinimized, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0" />
                                <RadioButton Content="{Binding StartupTrayLabel}" IsChecked="{Binding StartupModeTray, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding RunAsAdminLabel}" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="{Binding StartupAdminDescription}" Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}" IsEnabled="{Binding StartupControlsEnabled}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Style="{StaticResource StatusBadge}" VerticalAlignment="Center"><TextBlock Text="{Binding RealStartupStatus}" Style="{StaticResource StatusText}" /></Border>
                            <Button Style="{StaticResource SubtleButton}" Content="{Binding ApplyStartupText}" Command="{Binding RepairStartupCommand}" Margin="12,0,0,0" Visibility="{Binding StartWithWindows, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}">
                    <StackPanel>
                        <TextBlock Text="{Binding BehaviorTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding TrayDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MinimizeToTrayLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CloseToTrayLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding CompanionTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding CompanionDescription}" Style="{StaticResource SettingDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompanionEnableLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CompanionEnabled, Mode=TwoWay}"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompanionPortLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding CompanionPortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="70"/>
                        </Grid>
                        <TextBlock Text="{Binding CompanionPortValidationError}" Style="{StaticResource SmallMutedText}" Foreground="#FF6C6C" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasCompanionPortValidationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompanionStatusLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompanionStatusText}" Style="{StaticResource StatusText}"/>
                            </Border>
                        </Grid>
                        <StackPanel Visibility="{Binding IsCompanionRunning, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,8,0,0">
                            <TextBlock Text="{Binding CompanionEndpointLabel}" Style="{StaticResource TinyCapsText}"/>
                            <TextBox Text="{Binding CompanionEndpointText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Padding="0,2" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CompanionErrorMessage}" Style="{StaticResource SmallMutedText}" Foreground="#FF6C6C" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding IsCompanionFailed, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- M3 LAN Access & Pairing Controls -->
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,12,0,12" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CompanionLanEnableLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CompanionLanEnabled, Mode=TwoWay}"/>
                        </Grid>

                        <StackPanel Visibility="{Binding CompanionLanEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CompanionLanAddressLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanAddresses}" SelectedValue="{Binding CompanionLanAddress, Mode=TwoWay}" SelectedValuePath="IpAddress" DisplayMemberPath="IpAddress" Width="140"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CompanionLanStatusLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding LanStatusText}" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Device Pairing (available whenever the Companion service is running) -->
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,12,0,12" />
                        <StackPanel Visibility="{Binding IsPairingSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Pair New Device Button -->
                            <Button Style="{StaticResource SubtleButton}" Content="{Binding CompanionPairButtonLabel}" Command="{Binding StartPairingCommand}" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding PairingStatusMessage}" Style="{StaticResource SmallMutedText}" Foreground="#FF6C6C" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding PairingStatusMessage, Converter={StaticResource NonEmptyToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding CompanionPairingLanHintText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding CompanionLanEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                            <!-- Active Pairing Window Panel -->
                            <Border Visibility="{Binding IsPairingActive, Converter={StaticResource BoolToVisibilityConverter}}" Background="{StaticResource BrushSurfaceInteractive}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompanionPairingActiveText}" Style="{StaticResource DataTitleText}"/>
                                    <TextBlock Text="{Binding CompanionPairingUrlLabel}" Style="{StaticResource TinyCapsText}" Margin="0,4,0,0"/>
                                    <TextBox Text="{Binding PairingUrl, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource BrushSurfaceHover}" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8,5" Margin="0,2,0,8"/>
                                    <TextBlock Text="{Binding CompanionPairingTokenLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,0"/>
                                    <TextBox Text="{Binding PairingToken, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource BrushSurfaceHover}" Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8,5" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SubtleButton}" Content="{Binding CompanionCopyUrlLabel}" Command="{Binding CopyPairingUrlCommand}"/>
                                        <Button Style="{StaticResource SubtleButton}" Content="{Binding CompanionCancelPairButtonLabel}" Command="{Binding CancelPairingCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Pending Pairing Approval Panel -->
                            <Border Visibility="{Binding HasPendingPairingRequest, Converter={StaticResource BoolToVisibilityConverter}}" Background="#1E2A3A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding CompanionPendingTitle}" Style="{StaticResource SectionTitleText}" Foreground="#3B82F6"/>
                                    <TextBlock Text="{Binding PendingDeviceName}" Style="{StaticResource SettingTitleText}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding PendingSourceIp}" Style="{StaticResource SmallMutedText}" Margin="0,2,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding CompanionAllowLabel}" Command="{Binding AllowPairingCommand}"/>
                                        <Button Style="{StaticResource SubtleButton}" Content="{Binding CompanionDenyLabel}" Command="{Binding DenyPairingCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Device Store Fault Alert -->
                        <Border Visibility="{Binding IsDeviceStoreFaulted, Converter={StaticResource BoolToVisibilityConverter}}" Background="#2A1E1E" BorderBrush="#FF6C6C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CompanionStoreFaultTitle}" Style="{StaticResource SectionTitleText}" Foreground="#FF6C6C"/>
                                <TextBlock Text="{Binding CompanionStoreFaultMessage}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,8"/>
                                <Button Style="{StaticResource SubtleButton}" Content="{Binding CompanionResetStoreLabel}" Command="{Binding ResetDeviceStoreCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Paired Devices List -->
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,12,0,12" />
                        <TextBlock Text="{Binding CompanionPairedDevicesTitle}" Style="{StaticResource DataTitleText}"/>
                        <TextBlock Text="{Binding CompanionNoPairedDevicesLabel}" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0" Visibility="{Binding HasPairedDevices, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding PairedDevices}" Margin="0,6,0,0" Visibility="{Binding HasPairedDevices, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurfaceInteractive}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <!-- Device Header -->
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerSubtleButton}" Content="{Binding RevokeLabel}" Command="{Binding RevokeCommand}" VerticalAlignment="Center" Padding="8,4" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <!-- Metadata: Paired on & Last used -->
                                            <StackPanel Margin="0,5,0,0">
                                                <TextBlock Text="{Binding PairedOnText}" Style="{StaticResource SmallMutedText}"/>
                                                <TextBlock Text="{Binding LastUsedDisplay}" Style="{StaticResource SmallMutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,10,0,8" />

                                            <!-- Permissions Section Header -->
                                            <TextBlock Text="{Binding PermissionsHeader}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6"/>

                                            <!-- Permissions Matrix -->
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="68"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="24"/>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="28"/>
                                                    <RowDefinition Height="28"/>
                                                </Grid.RowDefinitions>

                                                <!-- Header Row -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AreaHeader}" Style="{StaticResource TinyCapsText}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReadHeader}" Style="{StaticResource TinyCapsText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ControlHeader}" Style="{StaticResource TinyCapsText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Telemetry -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AreaTelemetryLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ReadTelemetryEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeTelemetryLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding WriteTelemetryEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteTelemetryLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Game library -->
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AreaLibraryLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ReadLibraryEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeReadLibraryLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding WriteLaunchEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteLaunchLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Background apps -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding AreaBackgroundAppsLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ReadBackgroundAppsEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeReadBackgroundAppsLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding WriteBackgroundAppsEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteBackgroundAppsLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Optimization -->
                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AreaOptimizationLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding ReadOptimizationEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeReadOptimizationLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding WriteOptimizationEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteOptimizationLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Benchmarks -->
                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding AreaBenchmarksLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding ReadBenchmarksEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeReadBenchmarksLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="5" Grid.Column="2" IsChecked="{Binding WriteBenchmarksEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteBenchmarksLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                <!-- Session CPU -->
                                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding AreaSessionCpuLabel}" Style="{StaticResource SettingDescriptionText}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding ReadOptimizationCpuEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeReadOptimizationCpuLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Row="6" Grid.Column="2" IsChecked="{Binding WriteOptimizationCpuEnabled, Mode=TwoWay}" ToolTip="{Binding ScopeWriteOptimizationCpuLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="RightSettingsColumn" Grid.Column="2" Grid.Row="0">
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding BenchmarkEngineTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding BenchmarkEngineDescription}" Style="{StaticResource SettingDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding BenchmarkEngineStatus}" Style="{StaticResource StatusText}" /></Border><TextBlock Text="{Binding BenchmarkEngineVersion}" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" Margin="10,0,0,0" /></StackPanel>
                        <TextBlock Text="{Binding ThirdPartyComponents}" Style="{StaticResource DataTitleText}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ThirdPartyLicense}" Style="{StaticResource SettingDescriptionText}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding BenchmarkSafetyText}" Style="{StaticResource SettingDescriptionText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource SubtleButton}" Content="{Binding OpenThirdPartyNoticesText}" Command="{Binding OpenThirdPartyNoticesCommand}"/><Button Style="{StaticResource SubtleButton}" Content="{Binding OpenPresentMonProjectText}" Command="{Binding OpenPresentMonProjectCommand}" Margin="8,0,0,0"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding BenchmarkHotkeyTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding BenchmarkHotkeyDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding BenchmarkHotkeyEnableLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BenchmarkHotkeyEnabled, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding BenchmarkHotkeyCombinationLabel}" Style="{StaticResource TinyCapsText}"/>
                        <ItemsControl ItemsSource="{Binding BenchmarkHotkeyTokens}" Margin="0,7,0,10">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource BrushSurfaceInteractive}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,5,0"><TextBlock Text="{Binding}" Style="{StaticResource StatusText}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecordBenchmarkHotkeyButton"
                                    Style="{StaticResource SubtleButton}"
                                    Content="{Binding BenchmarkHotkeyRecordText}"
                                    Click="RecordBenchmarkHotkeyButton_Click"
                                    PreviewKeyDown="RecordBenchmarkHotkeyButton_PreviewKeyDown"/>
                            <Button Style="{StaticResource SubtleButton}" Content="{Binding BenchmarkHotkeyClearText}" Command="{Binding ClearBenchmarkHotkeyCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BenchmarkHotkeyStatus}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding LoggingTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding UpdatesDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CheckUpdatesLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogEnabledLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogEnabled, Mode=TwoWay}" /></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource SubtleButton}" Content="{Binding CheckUpdatesText}" Command="{Binding CheckUpdatesCommand}" /><Button Style="{StaticResource SubtleButton}" Content="{Binding OpenLogsText}" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" /></StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SafetyTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AllowRealtimeLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowRealtimePriority, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StorageSensorsLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableStorageSensors, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding DiagnosticsTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding DiagnosticsDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProcessRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding ProcessListRefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding WatcherRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding ProfileWatcherSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HardwareRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding HardwareRefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenAppDataText}" Command="{Binding OpenAppDataCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}">
                    <StackPanel>
                        <TextBlock Text="{Binding RestartAsAdminText}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding RestartAdminDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center"><TextBlock Text="{Binding AdminStatus}" Style="{StaticResource StatusText}" /></Border><Button Style="{StaticResource SubtleButton}" Content="{Binding RestartAsAdminText}" Command="{Binding RestartAsAdminCommand}" Margin="12,0,0,0" /></StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
