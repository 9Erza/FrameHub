<UserControl x:Class="FrameHub.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="False">
    <!-- The page title and description are owned by MainWindow/ShellViewModel. -->
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <Grid x:Name="ContentLayout" MaxWidth="1120" HorizontalAlignment="Stretch" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="LeftSettingsColumn" Grid.Column="0" Grid.Row="0">
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding LanguageTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding LanguageDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding EnglishLabel}" IsChecked="{Binding IsEnglish, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,8,0" />
                            <RadioButton Content="{Binding PolishLabel}" IsChecked="{Binding IsPolish, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding StartupTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StartWithWindowsLabel}" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="{Binding StartupDescription}" Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <StackPanel IsEnabled="{Binding StartupControlsEnabled}" Margin="0,0,0,12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StartWithWindows}" Value="False"><Setter Property="Opacity" Value="0.48" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding StartupBehaviorLabel}" Style="{StaticResource SettingTitleText}" />
                            <TextBlock Text="{Binding StartupModeDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{Binding StartupNormalLabel}" IsChecked="{Binding StartupModeNormal, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0" />
                                <RadioButton Content="{Binding StartupMinimizedLabel}" IsChecked="{Binding StartupModeMinimized, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0" />
                                <RadioButton Content="{Binding StartupTrayLabel}" IsChecked="{Binding StartupModeTray, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BrushBorderSoft}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding RunAsAdminLabel}" Style="{StaticResource SettingTitleText}" />
                                <TextBlock Text="{Binding StartupAdminDescription}" Style="{StaticResource SettingDescriptionText}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}" IsEnabled="{Binding StartupControlsEnabled}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Style="{StaticResource StatusBadge}" VerticalAlignment="Center"><TextBlock Text="{Binding RealStartupStatus}" Style="{StaticResource StatusText}" /></Border>
                            <Button Style="{StaticResource SubtleButton}" Content="{Binding ApplyStartupText}" Command="{Binding RepairStartupCommand}" Margin="12,0,0,0" Visibility="{Binding StartWithWindows, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}">
                    <StackPanel>
                        <TextBlock Text="{Binding BehaviorTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding TrayDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MinimizeToTrayLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CloseToTrayLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="RightSettingsColumn" Grid.Column="2" Grid.Row="0">
                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding LoggingTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding UpdatesDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CheckUpdatesLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LogEnabledLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogEnabled, Mode=TwoWay}" /></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Style="{StaticResource SubtleButton}" Content="{Binding CheckUpdatesText}" Command="{Binding CheckUpdatesCommand}" /><Button Style="{StaticResource SubtleButton}" Content="{Binding OpenLogsText}" Command="{Binding OpenLogsCommand}" Margin="8,0,0,0" /></StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SafetyTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AllowRealtimeLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowRealtimePriority, Mode=TwoWay}" /></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StorageSensorsLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableStorageSensors, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding DiagnosticsTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding DiagnosticsDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProcessRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding ProcessListRefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding WatcherRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding ProfileWatcherSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HardwareRefreshLabel}" Style="{StaticResource SettingTitleText}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Style="{StaticResource CompactNumberTextBox}" Text="{Binding HardwareRefreshSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="2" Text="s" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                        <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenAppDataText}" Command="{Binding OpenAppDataCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSectionSurface}">
                    <StackPanel>
                        <TextBlock Text="{Binding RestartAsAdminText}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding RestartAdminDescription}" Style="{StaticResource SettingDescriptionText}" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource BadgeBorder}" VerticalAlignment="Center"><TextBlock Text="{Binding AdminStatus}" Style="{StaticResource StatusText}" /></Border><Button Style="{StaticResource SubtleButton}" Content="{Binding RestartAsAdminText}" Command="{Binding RestartAsAdminCommand}" Margin="12,0,0,0" /></StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
