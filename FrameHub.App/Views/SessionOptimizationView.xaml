<UserControl x:Class="FrameHub.App.Views.SessionOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FrameHub.App.Helpers">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- One owner for vertical page scrolling. Data grids only scroll their bounded data viewport. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer x:Name="PageScrollViewer" Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Loaded="PageScrollViewer_Loaded">
        <StackPanel Margin="0,0,0,96">
            <!-- Chapter heading: the single H1 of this page. -->
            <TextBlock Text="{Binding Title}" Style="{StaticResource ChapterTitleText}" AutomationProperties.Name="{Binding Title}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" Margin="0,6,0,10" TextWrapping="Wrap" />

            <!-- FH-100-016: one short guide over the existing workflow (no new wizard). -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding WorkflowGuideTitle}" Style="{StaticResource SectionHeadingText}" />
                    <TextBlock Text="{Binding WorkflowGuideText}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Band A — live session/recovery strip. The sticky bar below stays the single in-frame action. -->
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StateBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True"><Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsRecoveryPending}" Value="True"><Setter Property="Background" Value="{StaticResource BrushWarningSoft}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Top" Margin="0,7,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding SessionStateDisplay}" Style="{StaticResource SectionHeadingText}" />
                        <TextBlock Text="{Binding ActiveSessionInfo}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Content="{Binding TestDetectionButtonText}" Command="{Binding TestDetectionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Plan + decision console: side by side when wide, single column when narrow. -->
            <Grid x:Name="PlanWorkspace">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <StackPanel x:Name="SessionConsolePanel" Grid.Column="0" Grid.Row="0">
            <!-- Manual start leads the workspace. -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ManualModeTitle}" Style="{StaticResource SectionHeadingText}" />
                    <TextBlock Text="{Binding ManualModeDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <TextBlock Text="{Binding ManualGameLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding StartButtonText}" Command="{Binding StartManualSessionCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StartNeedsGameText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource BrushWarning}" Visibility="{Binding StartNeedsGameVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Expander Header="{Binding AdvancedOptionsTitle}" Margin="0,16,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding WindowsInterfaceLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding WindowsInterfaceHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WindowsInterfaceEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                            <Border Height="24" Background="Transparent" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding HideTaskbarLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding HideTaskbarHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideTaskbarDuringSession, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                            <Border Height="24" Background="Transparent" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GamePriorityLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding GamePriorityHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding GamePriorityOverrideEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                            <Border Height="24" Background="Transparent" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PowerPlanLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding PowerPlanHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PowerPlanOverrideEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <!-- Automatic mode remains a separate configuration. -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AutoModeTitle}" Style="{StaticResource SectionHeadingText}" />
                            <TextBlock Text="{Binding AutoModeDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoModeEnabled, Mode=TwoWay}" Content="{Binding AutoModeSwitchLabel}" VerticalAlignment="Center" Margin="24,0,0,0" />
                    </Grid>

                    <!-- UI 3.0: single game choice lives in the Manual card above (same
                         SelectedGame). Automation keeps its per-game list + reload. -->
                    <TextBlock Text="{Binding AutoVsManualHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Grid Margin="0,20,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AutoGamesLabel}" Style="{StaticResource DataTitleText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AutoGamesSummary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Content="{Binding ReloadLibraryButtonText}" Command="{Binding ReloadLibraryCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <!-- FH-100-015: bounded, searchable, virtualized game list (~6 rows, own scroll). -->
                    <TextBlock Text="{Binding GameSearchLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource HintTextBox}" Tag="{Binding GameSearchPlaceholder}" Text="{Binding GameSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding GameSearchLabel}" />
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding ClearSearchButtonText}" Command="{Binding ClearGameSearchCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             MaxHeight="320" MinHeight="104"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InlineRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconSource}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ProcessName}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" /></StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding NoMatchingGamesText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding NoMatchingGamesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

                </StackPanel>

                <StackPanel x:Name="SessionPlanPanel" Grid.Column="2" Grid.Row="0">
            <!-- 1. Things FrameHub may suspend -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding WhatGetsPausedTitle}" Style="{StaticResource SectionHeadingText}" />
                    <TextBlock Text="{Binding WhatGetsPausedDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <TabControl Style="{StaticResource FrameHubTabControl}" ItemContainerStyle="{StaticResource FrameHubTabItem}">
                        <TabItem Header="{Binding BackgroundRulesTitle}">
                            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InlineRow}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>

                        <TabItem Header="{Binding RunningProcessesTitle}">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RunningProcessesHint}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowManualProcessList, Mode=TwoWay}" Content="{Binding ShowManualProcessesLabel}" Margin="20,0,0,0" />
                                </Grid>
                                <StackPanel Visibility="{Binding ManualProcessesPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,4"><TextBlock Text="{Binding ManualProcessesRecommendationTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ManualProcessesRecommendationText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel Visibility="{Binding ShowManualProcessList, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Style="{StaticResource ToolbarButton}" Content="{Binding RefreshProcessListButtonText}" Command="{Binding RefreshRunningProcessesCommand}" HorizontalAlignment="Right" Margin="0,12,0,8" />
                                    <Grid>
                                        <DataGrid BorderThickness="0" HeadersVisibility="Column" ItemsSource="{Binding RunningProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="250" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns><DataGridTemplateColumn Header="{Binding Data.SuspendColumnHeader, Source={StaticResource VmProxy}}" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="160" IsReadOnly="True" /><DataGridTextColumn Header="{Binding Data.InstanceColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding InstanceCount}" Width="70" IsReadOnly="True" /><DataGridTextColumn Header="{Binding Data.PathColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ExamplePath}" Width="2*" IsReadOnly="True"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding ExamplePath}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding NoRunningProcessesText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRunningProcessesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- 2. Concise preview and recovery list -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CandidateTitle}" Style="{StaticResource SectionHeadingText}" /><TextBlock Text="{Binding CandidateHint}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding CandidateSafetyNote}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /></Grid>
                    <Grid>
                        <DataGrid BorderThickness="0" HeadersVisibility="Column" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="180" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="{Binding Data.RuleColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding RuleName}" Width="140" /><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="160" /><DataGridTextColumn Header="{Binding Data.PidColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessId}" Width="72" /><DataGridTextColumn Header="{Binding Data.PathColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ExecutablePath}" Width="2*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding ExecutablePath}" /></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
                        <TextBlock Text="{Binding NoCandidatesText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoCandidatesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel Visibility="{Binding HasSuspendedProcesses, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,20,0,16" />
                        <TextBlock Text="{Binding ActiveSessionTitle}" Style="{StaticResource SectionHeadingText}" Margin="0,0,0,12" />
                        <DataGrid BorderThickness="0" HeadersVisibility="Column" ItemsSource="{Binding SuspendedProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="160" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding Data.RuleColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding RuleName}" Width="*" /><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="*" /><DataGridTextColumn Header="{Binding Data.PidColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessId}" Width="72" /><DataGridTextColumn Header="{Binding Data.TimeColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding SuspendedAt}" Width="96" /></DataGrid.Columns></DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>

    <!-- Sticky restore: always visible, disabled with reason outside a session. -->
    <Border Grid.Row="1" Background="{StaticResource BrushTitlebar}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="16,7">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" TextWrapping="Wrap"><Run Text="{Binding SessionStateDisplay, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding RestoreFooterHint, Mode=OneWay}" /></TextBlock>
            <Button Grid.Column="1" Style="{StaticResource SuccessButton}" Content="{Binding StopButtonText}" Command="{Binding StopSessionCommand}" MinWidth="180" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="{Binding StopButtonText}" ToolTip="{Binding RestoreFooterHint}" ToolTipService.ShowOnDisabled="True" />
        </Grid>
    </Border>
    </Grid>
</UserControl>
