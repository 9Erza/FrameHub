<UserControl x:Class="FrameHub.App.Views.SessionOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:FrameHub.App.Helpers">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>

    <!-- One owner for vertical page scrolling. Data grids only scroll their bounded data viewport. -->
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  Loaded="PageScrollViewer_Loaded">
        <StackPanel Margin="0,0,0,24">
            <Border Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource StateBanner}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSessionActive}" Value="True"><Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsRecoveryPending}" Value="True"><Setter Property="Background" Value="{StaticResource BrushWarningSoft}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Top" Margin="0,7,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding SessionStateDisplay}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding ActiveSessionInfo}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource ToolbarButton}" Content="{Binding TestDetectionButtonText}" Command="{Binding TestDetectionCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SuccessButton}" Content="{Binding StopButtonText}" Command="{Binding StopSessionCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. Automation -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AutoModeTitle}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding AutoModeDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoModeEnabled, Mode=TwoWay}" Content="{Binding AutoModeSwitchLabel}" VerticalAlignment="Center" Margin="24,0,0,0" />
                    </Grid>

                    <Grid Margin="0,20,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedGameLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinWidth="300" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding ReloadLibraryButtonText}" Command="{Binding ReloadLibraryCommand}" VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock Text="{Binding AutoGamesLabel}" Style="{StaticResource DataTitleText}" Margin="0,12,0,4" />
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InlineRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconSource}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ProcessName}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" /></StackPanel>
                                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. Things FrameHub may suspend -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding WhatGetsPausedTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding WhatGetsPausedDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <TabControl Style="{StaticResource FrameHubTabControl}" ItemContainerStyle="{StaticResource FrameHubTabItem}">
                        <TabItem Header="{Binding BackgroundRulesTitle}">
                            <ItemsControl ItemsSource="{Binding Rules}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InlineRow}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </TabItem>

                        <TabItem Header="{Binding RunningProcessesTitle}">
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RunningProcessesHint}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowManualProcessList, Mode=TwoWay}" Content="{Binding ShowManualProcessesLabel}" Margin="20,0,0,0" />
                                </Grid>
                                <StackPanel Visibility="{Binding ManualProcessesPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,16,0,4"><TextBlock Text="{Binding ManualProcessesRecommendationTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ManualProcessesRecommendationText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel Visibility="{Binding ShowManualProcessList, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Style="{StaticResource ToolbarButton}" Content="{Binding RefreshProcessListButtonText}" Command="{Binding RefreshRunningProcessesCommand}" HorizontalAlignment="Right" Margin="0,12,0,8" />
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding RunningProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="250" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <DataGrid.Columns><DataGridTemplateColumn Header="{Binding Data.SuspendColumnHeader, Source={StaticResource VmProxy}}" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="160" IsReadOnly="True" /><DataGridTextColumn Header="{Binding Data.InstanceColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding InstanceCount}" Width="70" IsReadOnly="True" /><DataGridTextColumn Header="{Binding Data.PathColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ExamplePath}" Width="2*" IsReadOnly="True" /></DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="{Binding NoRunningProcessesText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoRunningProcessesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <!-- 3. Concise preview and recovery list -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CandidateTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding CandidateHint}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" /></Grid>
                    <Grid>
                        <DataGrid ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="180" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="{Binding Data.RuleColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding RuleName}" Width="140" /><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="160" /><DataGridTextColumn Header="{Binding Data.PidColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessId}" Width="72" /><DataGridTextColumn Header="{Binding Data.PathColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ExecutablePath}" Width="2*" /></DataGrid.Columns></DataGrid>
                        <TextBlock Text="{Binding NoCandidatesText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoCandidatesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel Visibility="{Binding HasSuspendedProcesses, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,20,0,16" />
                        <TextBlock Text="{Binding ActiveSessionTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding SuspendedProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="160" HorizontalScrollBarVisibility="Auto" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="{Binding Data.RuleColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding RuleName}" Width="*" /><DataGridTextColumn Header="{Binding Data.ProcessColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessName}" Width="*" /><DataGridTextColumn Header="{Binding Data.PidColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding ProcessId}" Width="72" /><DataGridTextColumn Header="{Binding Data.TimeColumnHeader, Source={StaticResource VmProxy}}" Binding="{Binding SuspendedAt}" Width="96" /></DataGrid.Columns></DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. One explicit manual action -->
            <Border Style="{StaticResource SectionSurface}">
                <StackPanel>
                    <TextBlock Text="{Binding ManualModeTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ManualModeDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding ManualGameLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" DisplayMemberPath="DisplayName" MinWidth="320" HorizontalAlignment="Left" /></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding StartButtonText}" Command="{Binding StartManualSessionCommand}" MinWidth="160" VerticalAlignment="Bottom" Margin="24,0,0,0" />
                    </Grid>
                    <Expander Header="{Binding AdvancedOptionsTitle}" Margin="0,16,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding WindowsInterfaceLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding WindowsInterfaceHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding WindowsInterfaceEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                            <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,12" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding HideTaskbarLabel}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding HideTaskbarHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideTaskbarDuringSession, Mode=TwoWay}" VerticalAlignment="Center" Margin="16,0,0,0" /></Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
