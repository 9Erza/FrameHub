<UserControl x:Class="FrameHub.App.Views.SessionOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding SessionOptionsTitle}" Style="{StaticResource SectionTitleText}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource BrushSurfaceAlt}"
                                BorderBrush="{StaticResource BrushBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding WindowsInterfaceLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WindowsInterfaceHint}"
                                               Style="{StaticResource SmallMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding WindowsInterfaceEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{StaticResource BrushSurfaceAlt}"
                                BorderBrush="{StaticResource BrushBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding HideTaskbarLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HideTaskbarHint}"
                                               Style="{StaticResource SmallMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding HideTaskbarDuringSession, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Row 1: Automation + session preview/status -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource HeroCardBorder}" Height="540" Margin="0,0,8,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding AutoModeTitle}" Style="{StaticResource SectionTitleText}" />

                        <CheckBox Grid.Row="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding AutoModeEnabled, Mode=TwoWay}"
                                  Content="{Binding AutoModeSwitchLabel}"
                                  Margin="0,14,0,14" />

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGameLabel}" Style="{StaticResource SmallMutedText}" />
                                <ComboBox ItemsSource="{Binding Games}"
                                          SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          MinHeight="38"
                                          Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="{Binding ReloadLibraryButtonText}"
                                    Command="{Binding ReloadLibraryCommand}"
                                    MinWidth="120"
                                    Margin="14,20,0,0" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding AutoGamesLabel}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding Games}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushSurfaceAlt}"
                                                    BorderBrush="{StaticResource BrushBorderSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Margin="0,0,10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34"
                                                            Height="34"
                                                            Background="{StaticResource BrushSurface}"
                                                            BorderBrush="{StaticResource BrushBorderSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Margin="0,0,10,0">
                                                        <Image Source="{Binding IconSource}"
                                                               Width="26"
                                                               Height="26"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Height="540" Margin="8,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding CandidateTitle}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding CandidateHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" MinWidth="110" />
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reguła" Binding="{Binding RuleName}" Width="140" />
                                    <DataGridTextColumn Header="Proces" Binding="{Binding ProcessName}" Width="150" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                                    <DataGridTextColumn Header="Ścieżka" Binding="{Binding ExecutablePath}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="{Binding NoCandidatesText}" Style="{StaticResource SmallMutedText}" Margin="0,8,0,0" Visibility="{Binding NoCandidatesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ActiveSessionTitle}" Style="{StaticResource SectionTitleText}" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SuspendedProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reguła" Binding="{Binding RuleName}" Width="*" />
                                    <DataGridTextColumn Header="Proces" Binding="{Binding ProcessName}" Width="*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                                    <DataGridTextColumn Header="Czas" Binding="{Binding SuspendedAt}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="{Binding NoSuspendedText}" Style="{StaticResource SmallMutedText}" Margin="0,8,0,0" Visibility="{Binding NoSuspendedProcessesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 2: base rules + manual processes -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="{Binding BackgroundRulesTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding BackgroundRulesHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,16" />

                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushSurfaceAlt}" BorderBrush="{StaticResource BrushBorderSoft}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding RunningProcessesTitle}" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding RunningProcessesHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ShowManualProcessList, Mode=TwoWay}"
                                      Content="{Binding ShowManualProcessesLabel}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0" />
                        </Grid>

                        <Button Grid.Row="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="{Binding RefreshProcessListButtonText}"
                                Command="{Binding RefreshRunningProcessesCommand}"
                                MinWidth="150"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Visibility="{Binding ShowManualProcessList, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding RunningProcesses}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  Height="300"
                                  Margin="0,14,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowManualProcessList, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Wstrzymaj" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Proces" Binding="{Binding ProcessName}" Width="190" IsReadOnly="True" />
                                <DataGridTextColumn Header="Inst." Binding="{Binding InstanceCount}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="Ścieżka" Binding="{Binding ExamplePath}" Width="2*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Style="{StaticResource SoftCardBorder}"
                                Margin="0,14,0,0"
                                Visibility="{Binding ManualProcessesPlaceholderVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ManualProcessesRecommendationTitle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ManualProcessesRecommendationText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Text="{Binding NoRunningProcessesText}" Style="{StaticResource SmallMutedText}" Margin="0,10,0,0" Visibility="{Binding NoRunningProcessesVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!-- Row 3: manual start -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="{Binding ManualModeTitle}" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding ManualGameLabel}" Style="{StaticResource SmallMutedText}" Margin="0,10,0,6" />
                            <ComboBox ItemsSource="{Binding Games}"
                                      SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      MinHeight="38" />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveSessionInfo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" MinWidth="360">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="{Binding StartButtonText}"
                                    Command="{Binding StartManualSessionCommand}"
                                    Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="{Binding StopButtonText}"
                                        Command="{Binding StopSessionCommand}"
                                        Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Content="{Binding TestDetectionButtonText}"
                                        Command="{Binding TestDetectionCommand}"
                                        Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
