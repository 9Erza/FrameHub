<UserControl x:Class="FrameHub.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="0,0,0,24">
            <StackPanel Margin="0,4,0,16">
                <TextBlock Text="{Binding Title}" Style="{StaticResource ChapterTitleText}" AutomationProperties.Name="{Binding Title}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border Style="{StaticResource StateBanner}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TelemetryTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding TelemetryDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsMonitorEnabled}" Content="{Binding MonitorStatus}" VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <!-- QA E F4: sensor cards only (behavior panel moved below, always visible). -->
            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMonitorEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>

                <StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <Border Style="{StaticResource MetricCardBorder}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CpuLabel}" Style="{StaticResource CardTitleText}" /><TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushAccentPrimary}" /></Grid>
                                <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource CardValueText}" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding CpuLoadLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushAccentPrimary}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                <TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding CpuElevationHintText}" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCpuElevationHintVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardBorder}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding GpuLabel}" Style="{StaticResource CardTitleText}" /><TextBlock Grid.Column="1" Text="GPU" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushAccentSecondary}" /></Grid>
                                <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource CardValueText}" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding GpuLoadLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushAccentSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                <TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding RamLabel}" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding RamUsedTotalText}" Style="{StaticResource MetricText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding RamUsageText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                <ProgressBar Maximum="100" Value="{Binding RamUsage}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCardBorder}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding VramLabel}" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding VramUsedTotalText}" Style="{StaticResource MetricText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding VramUsageText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                <ProgressBar Maximum="100" Value="{Binding VramUsage}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource SoftCardBorder}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding StorageLabel}" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding StorageInfoText}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="HardwareOverview" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <!-- QA E F4: background behavior is state-independent (watcher status is live
                 either way), so it always renders and fills the OFF state honestly.
                 UI 3.0: when sensors are ON the right OFF-panel collapses — behavior
                 then spans the full width instead of leaving a dead void. -->
            <Border x:Name="HardwareBehaviorPanel" Grid.Column="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SectionSurface}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitorEnabled}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding BackgroundBehaviorTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                    <Border Style="{StaticResource InlineRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProfileWatcherTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ProfileWatcherStatus}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" /></Grid></Border>
                    <Border Style="{StaticResource InlineRow}"><StackPanel><TextBlock Text="{Binding StorageSensorsTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding StorageSensorsDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                    <Border Style="{StaticResource InlineRow}" BorderThickness="0"><StackPanel><TextBlock Text="{Binding RefreshModesTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding RefreshModesDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                </StackPanel>
            </Border>

            <!-- QA E F4: designed OFF empty state — what the module covers + live status,
                 no invented values, the toggle in the banner above stays the action. -->
            <Border x:Name="HardwareOffPanel" Grid.Column="2" Style="{StaticResource SectionSurface}" Visibility="{Binding IsMonitorEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource BrushAccentPrimary}" />
                    <TextBlock Text="{Binding MonitorStatus}" Style="{StaticResource SectionTitleText}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding MonitorDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <UniformGrid Columns="4" Margin="0,14,0,0">
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0" Padding="0,4" Margin="0,0,8,0"><TextBlock Text="{Binding CpuLabel}" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushTextMuted}" /></Border>
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0" Padding="0,4" Margin="0,0,8,0"><TextBlock Text="{Binding GpuLabel}" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushTextMuted}" /></Border>
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0" Padding="0,4" Margin="0,0,8,0"><TextBlock Text="{Binding RamLabel}" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushTextMuted}" /></Border>
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0" Padding="0,4"><TextBlock Text="{Binding VramLabel}" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushTextMuted}" /></Border>
                    </UniformGrid>
                    <!-- Honest OFF-state content: storage reports its real unavailability
                         (sensors off) instead of inventing values. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StorageLabel}" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Top" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StorageInfoText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource StatusText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            </Grid>

            <Border Style="{StaticResource SectionSurface}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding TimerResolutionTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding TimerResolutionDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,6,0,8" />
                    <TextBlock Text="{Binding TimerResolutionStatus}" Style="{StaticResource DataTitleText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="{Binding TimerResolutionRefreshText}"
                            Command="{Binding RefreshTimerResolutionCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
