<UserControl x:Class="FrameHub.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="0,0,0,24">
            <Border Style="{StaticResource StateBanner}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding TelemetryTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding TelemetryDescription}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" /><TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsMonitorEnabled}" Content="{Binding MonitorStatus}" VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <Grid>
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMonitorEnabled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <Border Style="{StaticResource MetricCardBorder}" Margin="0,0,6,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CpuLabel}" Style="{StaticResource CardTitleText}" /><TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushAccentPrimary}" /></Grid>
                                <TextBlock Text="{Binding CpuTempText}" Style="{StaticResource CardValueText}" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding CpuLoadLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><TextBlock Text="{Binding CpuLoadText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushAccentPrimary}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                <TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding CpuElevationHintText}" TextWrapping="Wrap" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCpuElevationHintVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardBorder}" Margin="6,0,0,0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding GpuLabel}" Style="{StaticResource CardTitleText}" /><TextBlock Grid.Column="1" Text="GPU" Style="{StaticResource TinyCapsText}" Foreground="{StaticResource BrushAccentSecondary}" /></Grid>
                                <TextBlock Text="{Binding GpuTempText}" Style="{StaticResource CardValueText}" Margin="0,10,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding GpuLoadLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><TextBlock Text="{Binding GpuLoadText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource BrushAccentSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
                                <TextBlock Text="{Binding BackendStatusText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SoftCardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding RamLabel}" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding RamUsedTotalText}" Style="{StaticResource MetricText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding RamUsageText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                <ProgressBar Maximum="100" Value="{Binding RamUsage}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SoftCardBorder}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding VramLabel}" Style="{StaticResource CardTitleText}" />
                                <TextBlock Text="{Binding VramUsedTotalText}" Style="{StaticResource MetricText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding VramUsageText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                <ProgressBar Maximum="100" Value="{Binding VramUsage}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource SectionSurface}">
                    <StackPanel>
                        <TextBlock Text="{Binding BackgroundBehaviorTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource InlineRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProfileWatcherTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ProfileWatcherStatus}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" /></Grid></Border>
                        <Border Style="{StaticResource InlineRow}"><StackPanel><TextBlock Text="{Binding StorageSensorsTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding StorageSensorsDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0"><StackPanel><TextBlock Text="{Binding RefreshModesTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding RefreshModesDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
