<UserControl x:Class="FrameHub.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FrameHub.App.Controls"
             xmlns:benchmark="clr-namespace:FrameHub.App.ViewModels.Benchmark"
             xmlns:benchmarkModels="clr-namespace:FrameHub.Core.Models.Benchmarking;assembly=FrameHub.Core"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="MetricStripCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceInteractive}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerMedium}"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceInteractive}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="BenchmarkQualityText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Valid}"><Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Warning}"><Setter Property="Foreground" Value="{StaticResource BrushWarning}"/></DataTrigger>
                <DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Invalid}"><Setter Property="Foreground" Value="{StaticResource BrushError}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BenchmarkHistoryListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="12,10"><ContentPresenter/></Border>
                            <Border x:Name="Rail" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="0,2,2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSurfaceSelected}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushBorderDefault}"/><Setter TargetName="Rail" Property="Background" Value="{StaticResource BrushAccentPrimary}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushAccentPrimary}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type benchmark:BenchmarkResultViewModel}">
            <StackPanel>
                <Border Style="{StaticResource HeroCardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding GameName}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/></StackPanel>
                            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource StatusBadge}"><Style.Triggers><DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Valid}"><Setter Property="Background" Value="{StaticResource BrushSuccessSoft}"/><Setter Property="BorderBrush" Value="{StaticResource BrushSuccess}"/></DataTrigger><DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Warning}"><Setter Property="Background" Value="{StaticResource BrushWarningSoft}"/><Setter Property="BorderBrush" Value="{StaticResource BrushWarning}"/></DataTrigger><DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Invalid}"><Setter Property="Background" Value="{StaticResource BrushErrorSoft}"/><Setter Property="BorderBrush" Value="{StaticResource BrushError}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Warning}"><Setter Property="Fill" Value="{StaticResource BrushWarning}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding QualityLevel}" Value="{x:Static benchmarkModels:BenchmarkQualityLevel.Invalid}"><Setter Property="Fill" Value="{StaticResource BrushError}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Quality}" Style="{StaticResource StatusText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource MetricStripCell}"><StackPanel><TextBlock Text="{Binding AverageLabel}" Style="{StaticResource TinyCapsText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AverageFps}" Style="{StaticResource CardValueText}"/><TextBlock Text="{Binding FpsUnit}" Style="{StaticResource MetricUnitText}" VerticalAlignment="Bottom" Margin="6,0,0,5"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource MetricStripCell}"><StackPanel><TextBlock Text="{Binding OneLowLabel}" Style="{StaticResource TinyCapsText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding OnePercentLow}" Style="{StaticResource CardValueText}"/><TextBlock Text="{Binding FpsUnit}" Style="{StaticResource MetricUnitText}" VerticalAlignment="Bottom" Margin="6,0,0,5"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource MetricStripCell}"><StackPanel><TextBlock Text="{Binding PointOneLowLabel}" Style="{StaticResource TinyCapsText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PointOnePercentLow}" Style="{StaticResource CardValueText}"/><TextBlock Text="{Binding FpsUnit}" Style="{StaticResource MetricUnitText}" VerticalAlignment="Bottom" Margin="6,0,0,5"/></StackPanel></StackPanel></Border>
                            <Border Style="{StaticResource MetricStripCell}" Margin="0"><StackPanel><TextBlock Text="{Binding P99Label}" Style="{StaticResource TinyCapsText}"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding P99Value}" Style="{StaticResource CardValueText}"/><TextBlock Text="{Binding MillisecondsUnit}" Style="{StaticResource MetricUnitText}" VerticalAlignment="Bottom" Margin="6,0,0,5"/></StackPanel></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SectionSurface}">
                        <StackPanel><TextBlock Text="{Binding ChartLabel}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/><controls:FrametimeChart Points="{Binding ChartPoints, Mode=OneWay}" Height="280"/></StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,14">
                            <StackPanel><TextBlock Text="{Binding QualityLabel}" Style="{StaticResource DataTitleText}"/><TextBlock Text="{Binding QualityIssues}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel>
                                <TextBlock Text="{Binding ContextLabel}" Style="{StaticResource DataTitleText}"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CpuProfileLabel}" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding CpuProfile}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis" MaxWidth="190"/></Grid>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SessionOptimizationLabel}" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding SessionOptimization}" Style="{StaticResource DataTitleText}"/></Grid>
                                <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding RequestedDurationLabel}" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding RequestedDuration}" Style="{StaticResource DataTitleText}"/></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,14">
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding MedianLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding MedianFps}" Style="{StaticResource SecondaryMetricText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding P95Label}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding P95}" Style="{StaticResource SecondaryMetricText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,8"><TextBlock Text="{Binding MinLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding MinFrameTime}" Style="{StaticResource SecondaryMetricText}"/></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding MaxLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding MaxFrameTime}" Style="{StaticResource SecondaryMetricText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding ValidFramesLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding ValidFrameCount}" Style="{StaticResource DataTitleText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding CaptureDurationLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding CaptureDuration}" Style="{StaticResource DataTitleText}"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding AnalyzedDurationLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding AnalyzedDuration}" Style="{StaticResource DataTitleText}"/></StackPanel>
                        <StackPanel><TextBlock Text="{Binding DroppedLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding DroppedCount}" Style="{StaticResource DataTitleText}"/></StackPanel>
                    </UniformGrid>
                </Border>

                <Expander Header="{Binding AdvancedLabel}">
                    <Border Style="{StaticResource DataPanel}" Padding="16">
                        <StackPanel><TextBlock Text="{Binding ProcessDetails}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/><TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/><TextBlock Text="{Binding SwapChain}" Style="{StaticResource DataTitleText}"/><TextBlock Text="{Binding SelectionReason}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,10"/><TextBlock Text="{Binding Methodology}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplayedTiming}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding BetweenDisplayChange}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding FrameTypes}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Diagnostics}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding StoragePath}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="{Binding PresentMonVersion, StringFormat=PresentMon/API: {0}}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/><TextBlock Text="{Binding FrameHubVersion, StringFormat=FrameHub: {0}}" Style="{StaticResource CaptionText}"/></StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl Style="{StaticResource FrameHubTabControl}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Style="{StaticResource FrameHubTabItem}" Header="{Binding CaptureTabText}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,24">
                    <Grid x:Name="CaptureWorkspace" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="CaptureConfigurationPanel" Style="{StaticResource SectionSurface}">
                            <StackPanel>
                                <TextBlock Text="{Binding TestConfigurationTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,14"/>
                                <Grid Visibility="{Binding HasSelectedGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" Background="{StaticResource BrushSurfaceInteractive}" BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1" CornerRadius="7"><Image Source="{Binding SelectedGame.IconSource}" Width="36" Height="36"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedGame.DisplayName}" Style="{StaticResource SectionTitleText}" FontSize="17"/><TextBlock Text="{Binding SelectedGame.SourceText}" Style="{StaticResource CaptionText}"/></StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource BrushTextMuted}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Fill" Value="{StaticResource BrushSuccess}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SelectedGame.StatusText}">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}"><Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedGame.ProcessDetail}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource DataPanel}" Padding="14" Visibility="{Binding HasNoSelectedGame, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" Margin="16,8"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center"/><TextBlock Text="{Binding NoRunningGameTitle}" Style="{StaticResource DataTitleText}" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="{Binding EmptyGamesText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,4,0,8"/><Button Style="{StaticResource ToolbarButton}" Content="{Binding RefreshText}" Command="{Binding RefreshGamesCommand}" HorizontalAlignment="Center"/></StackPanel>
                                </Border>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ChangeGameText}" Style="{StaticResource TinyCapsText}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" MaxWidth="420" HorizontalAlignment="Left"><ComboBox.ItemTemplate><DataTemplate><Grid MinWidth="300"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Style="{StaticResource DataTitleText}"/><TextBlock Text="{Binding SourceText}" Style="{StaticResource CaptionText}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                                <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,16"/>
                                <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource TinyCapsText}" Margin="0,0,0,7"/>
                                <WrapPanel><RadioButton Content="30 s" IsChecked="{Binding Duration30Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,6"/><RadioButton Content="60 s" IsChecked="{Binding Duration60Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,6"/><RadioButton Content="120 s" IsChecked="{Binding Duration120Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,6"/><RadioButton Content="{Binding CustomDurationLabel}" IsChecked="{Binding DurationCustomSelected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,6"/></WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,10" Visibility="{Binding UseCustomDuration, Converter={StaticResource BoolToVisibilityConverter}}"><TextBox Text="{Binding CustomDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/><TextBlock Text="{Binding CustomDurationUnit}" Style="{StaticResource DataTitleText}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                                <TextBlock Text="{Binding CountdownLabel}" Style="{StaticResource TinyCapsText}" Margin="0,7,0,7"/>
                                <WrapPanel><RadioButton Content="0 s" IsChecked="{Binding Countdown0Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0"/><RadioButton Content="3 s" IsChecked="{Binding Countdown3Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}" Margin="0,0,6,0"/><RadioButton Content="5 s" IsChecked="{Binding Countdown5Selected, Mode=TwoWay}" Style="{StaticResource SegmentRadioButton}"/></WrapPanel>
                                <TextBlock Text="{Binding ComparableHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Style="{StaticResource PrimaryButton}" Content="{Binding StartText}" Command="{Binding StartCommand}" MinWidth="190" Visibility="{Binding ShowStartAction, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Style="{StaticResource DangerButton}" Content="{Binding StopText}" Command="{Binding StopCommand}" MinWidth="190" Visibility="{Binding ShowStopAction, Converter={StaticResource BoolToVisibilityConverter}}"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="CaptureStatusPanel" Grid.Column="2">
                            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,14">
                                <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EngineLabel}" Style="{StaticResource TinyCapsText}"/><Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding RefreshText}" Command="{Binding RefreshGamesCommand}" Margin="8,-5,-5,-5"/></Grid><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse Width="7" Height="7" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource BrushError}"/><Style.Triggers><DataTrigger Binding="{Binding EngineReady}" Value="True"><Setter Property="Fill" Value="{StaticResource BrushSuccess}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding EngineStatus}" Style="{StaticResource DataTitleText}"/></StackPanel><TextBlock Text="{Binding EngineVersionText, StringFormat=PresentMon {0}}" Style="{StaticResource CaptionText}" Margin="14,1,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,14">
                                <StackPanel><TextBlock Text="{Binding HotkeyStatusText}" Style="{StaticResource TinyCapsText}"/><ItemsControl ItemsSource="{Binding HotkeyTokens}" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource KeyCap}"><TextBlock Text="{Binding}" Style="{StaticResource StatusText}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StateBanner}">
                                <StackPanel><TextBlock Text="{Binding CurrentStateTitle}" Style="{StaticResource TinyCapsText}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StateText}" Style="{StaticResource SectionTitleText}"/><TextBlock Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Visibility="{Binding ShowCaptureProgress, Converter={StaticResource BoolToVisibilityConverter}}"/></Grid><ProgressBar x:Name="CaptureProgressBar" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Margin="0,10,0,0" Visibility="{Binding ShowCaptureProgress, Converter={StaticResource BoolToVisibilityConverter}}"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/><Expander Header="{Binding DiagnosticsText}" Margin="0,6,0,0"><TextBox x:Name="DiagnosticsTextBox" Text="{Binding TechnicalError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="{Binding LatestResultTitle}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/><ContentControl Content="{Binding CurrentResult}"/></StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Style="{StaticResource FrameHubTabItem}" Header="{Binding HistoryTabText}">
            <Grid>
                <Border Style="{StaticResource EmptyStateBorder}" Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"><TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center"/><TextBlock Text="{Binding HistoryEmptyText}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="{Binding HistoryEmptyDescription}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Grid x:Name="HistoryWorkspace" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="HistoryListPanel" Style="{StaticResource SectionSurface}">
                        <DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HistoryTabText}" Style="{StaticResource SectionTitleText}"/><Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Content="{Binding RefreshText}" Command="{Binding RefreshHistoryCommand}"/></Grid><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}" ItemContainerStyle="{StaticResource BenchmarkHistoryListItem}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GameName}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding QualityText}" Style="{StaticResource BenchmarkQualityText}"/></Grid><TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}" Margin="0,2,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding AverageLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding AverageFpsText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding OneLowLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding OnePercentLowText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel></Grid><TextBlock Text="{Binding CpuProfileText}" Style="{StaticResource CaptionText}" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
                    </Border>
                    <ScrollViewer x:Name="HistoryDetailPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Style="{StaticResource SubtleButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenSessionFolderCommand}" CommandParameter="{Binding SelectedHistory}"/><Button Style="{StaticResource DangerSubtleButton}" Content="{Binding DeleteText}" Command="{Binding DeleteSessionCommand}" CommandParameter="{Binding SelectedHistory}" Margin="8,0,0,0"/></StackPanel><ContentControl Content="{Binding CurrentResult}"/></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Style="{StaticResource FrameHubTabItem}" Header="{Binding CompareTabText}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border Style="{StaticResource EmptyStateBorder}" Visibility="{Binding HasInsufficientComparisonSessions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"><TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center"/><TextBlock Text="{Binding CompareEmptyTitle}" Style="{StaticResource SectionTitleText}" TextAlignment="Center" Margin="0,10,0,0"/><TextBlock Text="{Binding CompareEmptyText}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <StackPanel Margin="0,0,0,24" Visibility="{Binding HasEnoughComparisonSessions, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SectionSurface}"><StackPanel><TextBlock Text="{Binding CompareSessionAHeader}" Style="{StaticResource TinyCapsText}"/><ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding ComparisonA, Mode=TwoWay}" DisplayMemberPath="ComparisonDisplayText" Margin="0,8,0,10"/><ContentControl Content="{Binding ComparisonA}"><ContentControl.ContentTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding GameName}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding AverageLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding AverageFpsText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding OneLowLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding OnePercentLowText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding QualityText}" Style="{StaticResource BenchmarkQualityText}" VerticalAlignment="Bottom"/></Grid></StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SectionSurface}"><StackPanel><TextBlock Text="{Binding CompareSessionBHeader}" Style="{StaticResource TinyCapsText}"/><ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding ComparisonB, Mode=TwoWay}" DisplayMemberPath="ComparisonDisplayText" Margin="0,8,0,10"/><ContentControl Content="{Binding ComparisonB}"><ContentControl.ContentTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding GameName}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding AverageLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding AverageFpsText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding OneLowLabel}" Style="{StaticResource TinyCapsText}"/><TextBlock Text="{Binding OnePercentLowText, StringFormat={}{0} FPS}" Style="{StaticResource SecondaryMetricText}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding QualityText}" Style="{StaticResource BenchmarkQualityText}" VerticalAlignment="Bottom"/></Grid></StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl></StackPanel></Border>
                        </Grid>
                        <TextBlock Text="{Binding CompareValidationText}" Style="{StaticResource StatusText}" Margin="0,0,0,10"/>
                        <Border Style="{StaticResource SectionSurface}">
                            <StackPanel><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CompareMetricHeader}" Style="{StaticResource TinyCapsText}"/><TextBlock Grid.Column="1" Text="{Binding CompareSessionAHeader}" Style="{StaticResource TinyCapsText}"/><TextBlock Grid.Column="2" Text="{Binding CompareSessionBHeader}" Style="{StaticResource TinyCapsText}"/><TextBlock Grid.Column="3" Text="{Binding CompareDeltaHeader}" Style="{StaticResource TinyCapsText}"/><TextBlock Grid.Column="4" Text="{Binding CompareChangeHeader}" Style="{StaticResource TinyCapsText}"/></Grid><ItemsControl ItemsSource="{Binding ComparisonRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InlineRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource DataTitleText}"/><TextBlock Grid.Column="1" Text="{Binding SessionA}" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="2" Text="{Binding SessionB}" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="3" Text="{Binding Delta}" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="4" Text="{Binding Percentage}" Style="{StaticResource DataTitleText}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
