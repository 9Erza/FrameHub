<UserControl x:Class="FrameHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="0,0,0,24">
            <!-- Chapter heading: the single H1 of this page. -->
            <TextBlock Text="{Binding Title}" Style="{StaticResource ChapterTitleText}" AutomationProperties.Name="{Binding Title}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <!-- Hero: session state left, one dominant local action right. -->
            <Border x:Name="HeroCard" Style="{StaticResource LedgerHeroCard}" Margin="0,20,0,0">
                <Grid x:Name="HeroGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="HeroStatusPanel" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushLive}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActivityLiveBadgeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiveActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding MainStatusTitle}" Style="{StaticResource PageEyebrowText}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SessionStateValue}" Style="{StaticResource LedgerDisplayText}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SessionStateDetail}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsSelectedGamingGameRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding GamingRunningText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding GamingStatusMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="HeroActionsPanel" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" MinWidth="240">
                        <!-- Empty library: navigate to the library or the session setup, never mutate. -->
                        <StackPanel Visibility="{Binding HasNoGamingGames, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding OpenLibraryText}" Command="{Binding NavigateLibraryCommand}" AutomationProperties.Name="{Binding OpenLibraryText}" HorizontalAlignment="Stretch" MinHeight="40" />
                            <Button Style="{StaticResource SecondaryButton}" Content="{Binding ConfigureSessionText}" Command="{Binding NavigateSessionCommand}" AutomationProperties.Name="{Binding ConfigureSessionText}" HorizontalAlignment="Stretch" Margin="0,8,0,0" MinHeight="36" />
                        </StackPanel>
                        <!-- Game ready: the single session entry point. -->
                        <StackPanel Visibility="{Binding HasGamingGames, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding StartGamingModeText}" Command="{Binding StartGamingModeCommand}" AutomationProperties.Name="{Binding StartGamingModeText}" HorizontalAlignment="Stretch" MinHeight="40"
                                    Visibility="{Binding IsGamingModeActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <Button Style="{StaticResource SuccessButton}" Content="{Binding GamingRestoreText}" Command="{Binding RestoreGamingModeCommand}" AutomationProperties.Name="{Binding GamingRestoreText}" HorizontalAlignment="Stretch" MinHeight="40"
                                    Visibility="{Binding IsGamingModeActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Work zones: 1.35:1 two-column composition, single column below 1100 DIP client width. -->
            <Grid x:Name="MainGrid" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <!-- Left zone: game / quick start + processes. -->
                <StackPanel x:Name="LeftStack" Grid.Column="0" Grid.Row="0">
                <Border Style="{StaticResource LedgerSectionCard}">
                    <StackPanel>
                    <TextBlock Text="{Binding GamingTitle}" Style="{StaticResource SectionHeadingText}" />
                    <TextBlock Text="{Binding GamingDescription}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding HeroNoGamesDetail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding HasNoGamingGames, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <!-- QA E F5: the hero keeps the single dominant Open-library CTA; the card
                         leads to session setup instead of duplicating it. -->
                    <Button Style="{StaticResource SubtleButton}" Content="{Binding ConfigureSessionText}" Command="{Binding NavigateSessionCommand}" AutomationProperties.Name="{Binding ConfigureSessionText}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" MinHeight="36"
                            Visibility="{Binding HasNoGamingGames, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowGamingSelector, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding GamingGames}" SelectedItem="{Binding SelectedGamingGame, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{Binding OpenBenchmarksText}" Command="{Binding OpenBenchmarksCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsGamingModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding GamingActiveText}" Style="{StaticResource DataTitleText}" />
                        <TextBlock Text="{Binding GamingModeDetail}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource LedgerSectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TopProcessesTitle}" Style="{StaticResource SectionHeadingText}" />
                        <TextBlock Text="{Binding TopProcessesHint}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,4" />
                        <TextBlock Text="{Binding TopProcessesEmpty}" Style="{StaticResource CaptionText}" Visibility="{Binding HasTopProcesses, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EvidenceRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DataTitleText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                                <ProgressBar Value="{Binding CpuRatio, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource DataTitleText}" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" />
                                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" Margin="0,2,0,0" FontFamily="{StaticResource FontMono}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SubtleButton}" Content="{Binding TopProcessesOpenText}" Command="{Binding NavigateMetricCommand}" CommandParameter="Processes" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasTopProcesses, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Right zone: latest benchmark / engine state + activity. -->
                <StackPanel x:Name="RightStack" Grid.Column="2" Grid.Row="0">
                    <!-- PresentMon unavailable: own honest panel with diagnostics/history links. -->
                    <Border Style="{StaticResource LedgerSectionCard}" Visibility="{Binding IsBenchmarkEngineReady, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource BrushError}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BenchmarkEngineBadgeText}" Style="{StaticResource DataTitleText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LatestBenchmarkResult}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenEngineLogText}" Command="{Binding NavigateLogsCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenBenchmarksText}" Command="{Binding OpenBenchmarksCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Engine state: the unavailable band above stays the honest down-state panel.
                         This card always renders so the engine-independent system rows below
                         balance the right column (QA E F4); the benchmark-specific header rows
                         only render once the engine is ready. -->
                    <Border Style="{StaticResource LedgerSectionCard}">
                        <StackPanel>
                    <TextBlock Text="{Binding LatestBenchmarkTitle}" Style="{StaticResource SectionHeadingText}" />
                    <Grid Margin="0,10,0,0" Visibility="{Binding IsBenchmarkEngineReady, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding LatestBenchmarkGame}" Style="{StaticResource DataTitleText}" />
                            <TextBlock Text="{Binding LatestBenchmarkResult}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBenchmarkEngineReady}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource BrushError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding BenchmarkEngineBadgeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBenchmarkEngineReady}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{Binding OpenBenchmarksText}" Command="{Binding OpenBenchmarksCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>

                    <!-- Former stat cards, now honest metadata rows — nothing removed, nothing invented. -->
                    <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EvidenceRow}">
                                    <Button Style="{StaticResource QuietButton}" Command="{Binding DataContext.NavigateMetricCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding TargetKey}" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch" Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource DataTitleText}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource SecondaryMetricText}" VerticalAlignment="Center" />
                                                <Ellipse Width="7" Height="7" Margin="10,0,0,0" Fill="{Binding Accent}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LedgerSectionCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding RecentActivityTitle}" Style="{StaticResource SectionHeadingText}" /><TextBlock Grid.Column="1" Text="{Binding RecentActivityCountText}" Style="{StaticResource StatusText}" VerticalAlignment="Center" /></Grid>
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource EvidenceRow}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Grid.Column="0"><Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Top" Margin="0,5,0,0" /><Border Width="1" Background="{StaticResource BrushBorderDefault}" Margin="3,15,0,-12" /></Grid><TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource CaptionText}" Margin="7,1,0,0" FontFamily="{StaticResource FontMono}" /><TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" /></Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SubtleButton}" Content="{Binding OpenActivityLogText}" Command="{Binding NavigateLogsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
