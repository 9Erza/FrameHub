<UserControl x:Class="FrameHub.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Margin="0,0,0,24">
            <!-- Operational answer: what FrameHub is doing now. -->
            <Border Style="{StaticResource StateBanner}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="8" Background="{StaticResource BrushAccentSoft}" Margin="0,0,16,0">
                        <TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="{StaticResource BrushAccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MainStatusTitle}" Style="{StaticResource PageEyebrowText}" />
                        <TextBlock Text="{Binding SessionStateValue}" Style="{StaticResource MetricText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SessionStateDetail}" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BrushSuccessSoft}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" /><TextBlock Text="{Binding RecentActivityLiveText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" /></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCardBorder}" Margin="0,0,8,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleText}" /><Ellipse Grid.Column="1" Width="7" Height="7" Fill="{Binding Accent}" /></Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource CardValueText}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Text="{Binding Detail}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Gaming Mode quick action: compact game selector + composed launch/optimize flow. -->
            <Border Style="{StaticResource SectionSurface}" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding GamingTitle}" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding GamingDescription}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding GamingEmptyText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Visibility="{Binding HasNoGamingGames, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,4" />

                    <StackPanel Visibility="{Binding ShowGamingSelector, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding GamingGames}" SelectedItem="{Binding SelectedGamingGame, Mode=TwoWay}" MinWidth="320" MaxWidth="480" HorizontalAlignment="Left">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsSelectedGamingGameRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding GamingRunningText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding StartGamingModeText}" Command="{Binding StartGamingModeCommand}" VerticalAlignment="Top" Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsGamingModeActive, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding GamingActiveText}" Style="{StaticResource DataTitleText}" />
                                <TextBlock Text="{Binding GamingModeDetail}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SuccessButton}" Content="{Binding GamingRestoreText}" Command="{Binding RestoreGamingModeCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding GamingStatusMessage}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionSurface}" Margin="0,0,0,16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding LatestBenchmarkTitle}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{Binding LatestBenchmarkGame}" Style="{StaticResource DataTitleText}" Margin="0,6,0,0"/><TextBlock Text="{Binding LatestBenchmarkResult}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="{Binding OpenBenchmarksText}" Command="{Binding OpenBenchmarksCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionSurface}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MainStatusTitle}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding MainStatusDescription}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <Border Style="{StaticResource InlineRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushInformation}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding ProfileMonitorTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding ProfileMonitorText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel><Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource BrushSuccess}" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid>
                        </Border>
                        <Border Style="{StaticResource InlineRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xEC4A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding SessionOptimizationTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding SessionAutomationText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel><Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid>
                        </Border>
                        <Border Style="{StaticResource InlineRow}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding LastProfileTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding LastProfileText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></Grid>
                        </Border>
                        <Border Style="{StaticResource InlineRow}" BorderThickness="0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource BrushWarning}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding LoggingTitle}" Style="{StaticResource DataTitleText}" /><TextBlock Text="{Binding LoggingText}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SectionSurface}" Margin="12,0,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding RecentActivityTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Grid.Column="1" Text="{Binding RecentActivityLiveText}" Style="{StaticResource StatusText}" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center" /></Grid>
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InlineRow}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Grid.Column="0"><Ellipse Width="7" Height="7" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Top" Margin="0,5,0,0" /><Border Width="1" Background="{StaticResource BrushBorderDefault}" Margin="3,15,0,-12" /></Grid><TextBlock Grid.Column="1" Text="{Binding Time}" Style="{StaticResource CaptionText}" Margin="7,1,0,0" /><TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource BodyText}" TextWrapping="Wrap" /></Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
