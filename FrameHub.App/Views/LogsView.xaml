<UserControl x:Class="FrameHub.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource DataPanel}" VerticalAlignment="Top" MinHeight="220" MaxHeight="520">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="16,14,14,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ActivityTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ToolbarButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource DangerSubtleButton}" Content="{Binding ClearText}" Command="{Binding ClearActivityCommand}" MinHeight="30" Padding="10,6" /></StackPanel>
            </Grid>

            <ListBox x:Name="ActivityList" Grid.Row="1" ItemsSource="{Binding Activity}" Margin="8,0,8,8" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InlineRow}" Padding="10,10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Style="{StaticResource CodeText}" Foreground="{StaticResource BrushTextMuted}" /><Ellipse Grid.Column="1" Width="5" Height="5" Fill="{StaticResource BrushAccentPrimary}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="8,0,0,0" /></Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Margin="24" Panel.ZIndex="2">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorder}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ActivityList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock Text="{Binding ActivityTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" /><Button Style="{StaticResource SecondaryButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" /></StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
