<UserControl x:Class="FrameHub.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- QA E F4: title row (Auto) + activity panel (*) fills the available height;
         the list scrolls internally with a sticky header and footer. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,4,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource ChapterTitleText}" AutomationProperties.Name="{Binding Title}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource DataPanel}" VerticalAlignment="Stretch" MinHeight="140">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="16,14,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ActivityTitle}" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding CountText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ToolbarButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" AutomationProperties.Name="{Binding OpenFolderText}" /><Button Style="{StaticResource DangerSubtleButton}" Content="{Binding ClearText}" Command="{Binding ClearActivityCommand}" MinHeight="30" Padding="10,6" AutomationProperties.Name="{Binding ClearText}" /></StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="16,0,14,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding SearchPlaceholderText}" ToolTip="{Binding SearchPlaceholderText}" />
                <TextBlock Grid.Column="0" Text="{Binding SearchPlaceholderText}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding FilterLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding LevelFilterOptions}" SelectedIndex="{Binding SelectedLevelFilterIndex}" MinHeight="30" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding FilterLabel}" />
            </Grid>

            <ListBox x:Name="ActivityList" Grid.Row="2" ItemsSource="{Binding ActivityView}" Margin="8,0,8,8" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="{Binding ActivityTitle}">
                <ListBox.Background><SolidColorBrush Color="{StaticResource ColorSurface}" /></ListBox.Background>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Message}" /></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InlineRow}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Style.Triggers><DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource BrushWarning}" /></DataTrigger><DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{StaticResource BrushError}" /></DataTrigger><DataTrigger Binding="{Binding Level}" Value="Fatal"><Setter Property="Foreground" Value="{StaticResource BrushError}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Margin="24" Panel.ZIndex="2">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorder}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ActivityList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock Text="{Binding ActivityTitle}" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Center" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryBodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" /><Button Style="{StaticResource SecondaryButton}" Content="{Binding OpenFolderText}" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" /></StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="16,0,14,10" Padding="12" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=ActivityList}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel DataContext="{Binding SelectedItem, ElementName=ActivityList}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="{Binding Time}" FontFamily="{StaticResource FontMono}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding Level}" Style="{StaticResource StatusText}" Margin="12,0,0,0"/></StackPanel>
                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{Binding Message}" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Text="{Binding BoundedNoteText}" Style="{StaticResource CaptionText}" Margin="16,0,14,12" TextWrapping="Wrap" />
        </Grid>
    </Border>
    </Grid>
</UserControl>
