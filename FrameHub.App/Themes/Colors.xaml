<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- FrameHub Ember Ledger: warm graphite canvas, ember accent, Segoe UI + Consolas-numbers. -->
    <Color x:Key="ColorBackground">#100F0D</Color>
    <Color x:Key="ColorBackgroundAlt">#141210</Color>
    <Color x:Key="ColorSidebar">#141210</Color>
    <Color x:Key="ColorTitlebar">#100F0D</Color>

    <Color x:Key="ColorSurface">#191714</Color>
    <Color x:Key="ColorSurfaceRaised">#23201B</Color>
    <Color x:Key="ColorSurfaceInteractive">#23201B</Color>
    <Color x:Key="ColorSurfaceHover">#2D2821</Color>
    <Color x:Key="ColorSurfaceSelected">#2D2821</Color>

    <Color x:Key="ColorBorderSubtle">#39332B</Color>
    <Color x:Key="ColorBorderDefault">#817464</Color>
    <Color x:Key="ColorBorderStrong">#A89C88</Color>

    <Color x:Key="ColorTextPrimary">#F4EFE6</Color>
    <Color x:Key="ColorTextSecondary">#C3B9AA</Color>
    <Color x:Key="ColorTextMuted">#AA9F8F</Color>
    <Color x:Key="ColorTextDisabled">#93877A</Color>

    <Color x:Key="ColorAccentPrimary">#F5A623</Color>
    <Color x:Key="ColorAccentSecondary">#F5A623</Color>
    <Color x:Key="ColorAccentSoft">#2E2413</Color>
    <Color x:Key="ColorAccentHover">#FFBB4A</Color>
    <Color x:Key="ColorAccentInk">#17120A</Color>
    <Color x:Key="ColorFocus">#FFD38A</Color>

    <Color x:Key="ColorSuccess">#69D5A3</Color>
    <Color x:Key="ColorSuccessSoft">#16281F</Color>
    <Color x:Key="ColorWarning">#F4C268</Color>
    <Color x:Key="ColorWarningSoft">#332914</Color>
    <Color x:Key="ColorError">#FF858A</Color>
    <Color x:Key="ColorErrorSoft">#33191B</Color>
    <Color x:Key="ColorInformation">#D8C39A</Color>
    <Color x:Key="ColorInformationSoft">#2E2413</Color>
    <Color x:Key="ColorLive">#F5A623</Color>
    <!-- Supporter gold: reserved exclusively for Supporter surfaces. Never a product CTA. -->
    <Color x:Key="ColorCoffee">#D6B66E</Color>
    <Color x:Key="ColorCoffeeSoft">#2E2413</Color>
    <Color x:Key="ColorSupporter">#D6B66E</Color>
    <Color x:Key="ColorSupporterSoft">#2E2413</Color>
    <Color x:Key="ColorSupporterInk">#241B08</Color>
    <Color x:Key="ColorBand">#141210</Color>

    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space6">6</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space40">40</Thickness>
    <CornerRadius x:Key="CornerSmall">5</CornerRadius>
    <CornerRadius x:Key="CornerMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerLarge">11</CornerRadius>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushBackgroundAlt" Color="{StaticResource ColorBackgroundAlt}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushTitlebar" Color="{StaticResource ColorTitlebar}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushSurfaceInteractive" Color="{StaticResource ColorSurfaceInteractive}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceSelected" Color="{StaticResource ColorSurfaceSelected}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentInk" Color="{StaticResource ColorAccentInk}" />
    <SolidColorBrush x:Key="BrushFocus" Color="{StaticResource ColorFocus}" />
    <SolidColorBrush x:Key="BrushLive" Color="{StaticResource ColorLive}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="{StaticResource ColorSuccessSoft}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="{StaticResource ColorWarningSoft}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushErrorSoft" Color="{StaticResource ColorErrorSoft}" />
    <SolidColorBrush x:Key="BrushInformation" Color="{StaticResource ColorInformation}" />
    <SolidColorBrush x:Key="BrushInformationSoft" Color="{StaticResource ColorInformationSoft}" />
    <SolidColorBrush x:Key="BrushCoffee" Color="{StaticResource ColorCoffee}" />
    <SolidColorBrush x:Key="BrushCoffeeSoft" Color="{StaticResource ColorCoffeeSoft}" />
    <SolidColorBrush x:Key="BrushSupporter" Color="{StaticResource ColorSupporter}" />
    <SolidColorBrush x:Key="BrushSupporterSoft" Color="{StaticResource ColorSupporterSoft}" />
    <SolidColorBrush x:Key="BrushSupporterInk" Color="{StaticResource ColorSupporterInk}" />
    <SolidColorBrush x:Key="BrushBand" Color="{StaticResource ColorBand}" />
    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorBackground}" />

    <!-- Compatibility aliases used by existing presentation bindings. -->
    <SolidColorBrush x:Key="BrushWindowChrome" Color="{StaticResource ColorTitlebar}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceInteractive}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorderDefault}" />
    <SolidColorBrush x:Key="BrushBorderSoft" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryDark" Color="#D98B15" />
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource ColorLive}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushHeroGradient" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushPrimaryGradient" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushSelectedGradient" Color="{StaticResource ColorSurfaceSelected}" />

    <!-- Motion tokens: subtle state transitions only; no loops, no blur. -->
    <Duration x:Key="UiDurationFast">0:0:0.12</Duration>
    <Duration x:Key="UiDurationNormal">0:0:0.16</Duration>
</ResourceDictionary>
