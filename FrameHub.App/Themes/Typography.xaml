<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Type scale tokens (device-independent px). WPF scales DIPs with system DPI, so one
         token set covers 100/125/150/200% with no per-DPI sizes; ClearType + Display formatting
         below keep small sizes crisp. Change a token, not a literal, when the scale evolves. -->
    <sys:Double x:Key="TypeSizeEyebrow">11</sys:Double>
    <sys:Double x:Key="TypeSizeDisplay">32</sys:Double>
    <sys:Double x:Key="TypeLineDisplay">40</sys:Double>
    <sys:Double x:Key="TypeSizePageTitle">24</sys:Double>
    <sys:Double x:Key="TypeLinePageTitle">32</sys:Double>
    <sys:Double x:Key="TypeSizeSubtitle">13.5</sys:Double>
    <sys:Double x:Key="TypeLineSubtitle">21</sys:Double>
    <sys:Double x:Key="TypeSizeSection">18</sys:Double>
    <sys:Double x:Key="TypeLineSection">25</sys:Double>
    <sys:Double x:Key="TypeSizeData">14</sys:Double>
    <sys:Double x:Key="TypeLineData">21</sys:Double>
    <sys:Double x:Key="TypeSizeBody">14</sys:Double>
    <sys:Double x:Key="TypeLineBody">22</sys:Double>
    <sys:Double x:Key="TypeSizeSecondary">13</sys:Double>
    <sys:Double x:Key="TypeLineSecondary">20</sys:Double>
    <sys:Double x:Key="TypeSizeCaption">12</sys:Double>
    <sys:Double x:Key="TypeLineCaption">18</sys:Double>
    <sys:Double x:Key="TypeSizeMetric">40</sys:Double>
    <sys:Double x:Key="TypeLineMetric">46</sys:Double>
    <sys:Double x:Key="TypeSizeMetricSecondary">21</sys:Double>
    <sys:Double x:Key="TypeSizeStatus">11.5</sys:Double>
    <sys:Double x:Key="TypeSizeCard">15</sys:Double>
    <sys:Double x:Key="TypeSizeDefault">13</sys:Double>
    <!-- One standard Windows sans-serif family is used for all application text. -->
    <FontFamily x:Key="FrameHubFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubFontSemiBold">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubFontBold">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubFontExtraBold">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubDisplayFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubMetricFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="FrameHubMonoFontFamily">Consolas, Segoe UI</FontFamily>
    <!-- Compatibility aliases keep every existing view on the same centralized family. -->
    <StaticResource x:Key="FontUi" ResourceKey="FrameHubFontFamily" />
    <StaticResource x:Key="FontDisplay" ResourceKey="FrameHubFontBold" />
    <StaticResource x:Key="FontMetric" ResourceKey="FrameHubMetricFontFamily" />
    <StaticResource x:Key="FontMono" ResourceKey="FrameHubMonoFontFamily" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeDefault}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="PageEyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentPrimary}" />
    </Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizePageTitle}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLinePageTitle}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <!-- Ember Ledger H1: one per screen, semibold, never light. -->
    <Style x:Key="ChapterTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubDisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <!-- Ember Ledger display cut for hero status values. -->
    <Style x:Key="LedgerDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubDisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="ChapterDisplayText" TargetType="TextBlock" BasedOn="{StaticResource ChapterTitleText}">
        <Setter Property="FontSize" Value="{StaticResource TypeSizeMetric}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineMetric}" />
    </Style>
    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeSubtitle}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineSubtitle}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeSection}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineSection}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <!-- Session Chapters band heading: section scale with eyebrow rhythm. -->
    <Style x:Key="SectionHeadingText" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}" />
    <Style x:Key="DataTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeData}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineData}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeBody}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineBody}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="SecondaryBodyText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="{StaticResource TypeSizeSecondary}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeCaption}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>
    <Style x:Key="MetricText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubMetricFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeMetric}" />
        <Setter Property="LineHeight" Value="{StaticResource TypeLineMetric}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="SecondaryMetricText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubMetricFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeMetricSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>
    <Style x:Key="MetricUnitText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>

    <Style x:Key="SettingTitleText" TargetType="TextBlock" BasedOn="{StaticResource DataTitleText}" />
    <Style x:Key="SettingDescriptionText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryBodyText}"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeStatus}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeCard}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style x:Key="CardValueText" TargetType="TextBlock" BasedOn="{StaticResource MetricText}" />
    <Style x:Key="SmallMutedText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}" />
    <Style x:Key="TinyCapsText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>
    <Style x:Key="NavGroupText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FrameHubFontSemiBold}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>
</ResourceDictionary>
